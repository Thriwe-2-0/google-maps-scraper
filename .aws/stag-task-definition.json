{
  "family": "stag-scraper-service",
  "executionRoleArn": "arn:aws:iam::295287649808:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::295287649808:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "stag-scraper-service",
      "image": "295287649808.dkr.ecr.ap-south-1.amazonaws.com/scraper-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stag-srcaper-service",
          "awslogs-region": "ap-south-1",
          "awslogs-create-group": "true",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "secrets": [
        {
          "name": "SQL_URI",
          "valueFrom": "arn:aws:ssm:ap-south-1:295287649808:parameter/sql-uri"
        },
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:ssm:ap-south-1:295287649808:parameter/mongodb-uri"
        }
      ]
    }
  ],
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX"
  }
}
